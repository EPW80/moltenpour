node_modules/
dist/
*.log
*:Zone.Identifier

# Rendered certificate proofs and PDFs from `npm run verify:certificate`.
# Regenerated on demand; the check is the deliverable, not the output.
artifacts/

# The ledger. Real pours, local to whoever ran the server — and the WAL and
# shared-memory files SQLite keeps beside it.
*.db
*.db-wal
*.db-shm

# Copies of the live ledger pulled by scripts/backup-ledger.sh. The files
# themselves are already ignored above; this keeps the timestamped directories
# out too. A backup belongs somewhere backed up, not in the source tree.
backups/
